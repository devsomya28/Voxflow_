# VoxFlow Environment Configuration (Template)
# Copy this file to `backend/.env` and supply your actual credentials.
# NEVER commit your `.env` file to version control.

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS — allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Default: Local SQLite database for zero-config startup and testing
DATABASE_URL=sqlite+aiosqlite:///./voxflow.db
USE_SQLITE_FALLBACK=true

# If using PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxflow

# Gnani AI API Credentials
# Official REST API (Prisma v2.5 STT):
# Requires only GNANI_API_KEY sent as X-API-Key-ID header
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://tts.gnani.ai/v2.5/synthesize

# Gnani Evon / Reasoning Model (if provisioned on your account):
GNANI_EVON_API_KEY=
GNANI_EVON_URL=https://evon.gnani.ai/v3.3/extract
