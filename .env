# VoxFlow Local Development Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Set your Postgres password/port if running locally):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxflow

# Automatic zero-config fallback to SQLite if PostgreSQL is offline
USE_SQLITE_FALLBACK=true
SQLITE_URL=sqlite+aiosqlite:///./voxflow.db

# Optional: Add your Gnani AI keys when ready
